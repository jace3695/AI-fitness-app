import {writeFileSync} from 'node:fs';
import {originalLines} from '../lib/drawing/original-guide.ts';
const steps:Record<number,string[]>={};
Object.assign(steps,{
71:['앱에서 반겨주는 친구 또는 작은 모험가 중 역할을 골라요.','다정함·호기심 중 성격을 고르거나 직접 적어요.','새싹 또는 작은 새의 큰 몸 모양을 봐요.','작은 낙서 하나로 몸과 대표 특징을 그려요.','역할과 성격을 한 문장으로 말하고 비교해요.'],
72:['저장한 D71을 골라 같은 친구를 이어 만들어요.','둥근 후보 연습장에 큰 몸과 눈을 그려요.','길쭉한 후보 연습장에 다른 인상의 몸을 그려요.','이어 만들 몸 하나와 고른 이유를 정해요.','두 후보를 비교하고 모두 저장해요.'],
73:['저장한 D72의 선택한 몸을 가져와요.','선택한 큰 몸을 다시 그려요.','한 줄기 또는 갈라진 잎·깃 중 대표 특징 하나를 골라요.','눈·입을 넣고 작은 크기의 특징을 확인해요.','대표 특징 하나를 짚어 설명해요.'],
74:['저장한 D73의 특징을 이어 받아 기준 한 장을 만들어요.','머리·몸이 하나인 큰 덩어리를 그려요.','대표 특징과 짧은 팔다리를 이어요.','눈·입을 넣고 복잡한 선 한 곳을 줄여요.','다음에도 따라 그릴 내 정면 기본형을 저장해요.'],
75:['내 D74 원본을 옆에 놓아요.','같은 큰 몸 덩어리부터 새로 그려요.','대표 특징과 팔다리를 이어요.','눈·입을 넣고 원본과 한 관계를 비교해요.','유지한 모양과 고칠 한 곳을 메모해요.'],
76:['내 D74 원본 선화를 골라 복사해요.','주색·보조색 두 가지 조합을 골라요.','주색 연필로 넓은 몸 부분을 칠해요.','보조색 연필로 대표 특징을 칠해요.','작은 크기에서 두 부분이 구별되는지 확인해요.'],
77:['내 D74를 골라 기준 얼굴을 봐요.','같은 큰 몸과 특징을 옮겨 그려요.','반가움 또는 놀람을 골라요.','눈·입만 바꾸고 팔다리는 유지해요.','기본형과 같은 특징을 비교하고 첫 표정을 저장해요.'],
78:['내 D74 기본형과 D77 첫 표정을 골라요.','두 그림에 아직 없는 표정을 골라요.','큰 몸·대표 특징을 유지해 세 번째 그림을 그려요.','눈·입을 바꾸고 세 장의 특징을 비교해요.','한 곳을 보완하고 서로 다른 세 표정을 저장해요.'],
79:['내 D74 기본 자세를 골라요.','인사 연습장에 같은 몸·특징을 그려요.','위로 든 팔을 넣고 오늘은 여기까지 저장해도 돼요.','두 번째 연습장에서 앉기 또는 걷기를 그려요.','기본·인사·다른 자세 세 장의 특징을 비교해요.'],
80:['내 D74·D78·D79의 기준·표정·자세 모음을 골라요.','이름·역할·성격을 적어요.','몸 비율·대표 장식·눈 간격 중 특징 두 개를 골라요.','작은 카드의 실제 그림을 보고 다음에 바꿀 것 하나를 적어요.','소개 카드와 다시 그릴 기준 자료를 저장해요.']});
for(let n=71;n<=80;n++){
 const examples=(['sprout','bird'] as const).map(motif=>({id:`d${n}-${motif}`,name:`${motif==='sprout'?'새싹 친구':'작은 새 친구'} · 내 캐릭터 출발 예제`,source:'연이 자체 제작 창작 방법 도해. 역할·비율·대표 특징을 선택하고 내 연습장에 직접 그리는 출발점.',original:{motif},lines:originalLines({motif,body:'round',mark:'single',palette:0})}));
 writeFileSync(`content/drawing/reviewed/d${n}.json`,JSON.stringify({id:`D${n}`,originalPractice:true,examples,steps:steps[n].map((text,i)=>({text,lines:[],action:i===0?'look':i===4?'compare':n===80?'collect':'draw'})),readiness:{manuscript:true,examples:true,visualMatch:process.argv.includes('--reviewed'),browser:false}},null,2)+'\n');}
console.log('D71–D80: 10 lessons / 20 starting examples; dynamic variants rendered by OriginalDiagram.');
