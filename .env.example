NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
GOOGLE_CALENDAR_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-web-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
# OAuth 클라이언트 비밀키와 별도로 토큰 암호화 키를 유지하려면 설정합니다.
# GOOGLE_TOKEN_ENCRYPTION_SECRET=replace-with-a-long-random-secret

# Zephyr stays OFF until the billing test and shared monthly allowance are verified.
# The monthly DB grant is also required; this flag alone never permits a call.
GOOGLE_TTS_FREE_ENABLED=false
# GOOGLE_TTS_API_KEY is server-only; enter it only in Vercel's Value field.
