{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "alignment",
          "format": "url",
          "env": "YEONI_ALIGNMENT_INTERNAL_URL"
        }
      ]
    },
    "alignment": {
      "root": "services/yeoni-alignment",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
